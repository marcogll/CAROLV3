{
  "survey_id": "carol_registration_v2",
  "fields": [
    { "name": "full_name", "type": "text", "required": true },
    { "name": "employee_id", "type": "text", "required": true },
    { "name": "company_name", "type": "text", "required": true },
    { "name": "contact_email", "type": "email", "required": true },
    { "name": "birth_year", "type": "select", "required": true },
    { "name": "birth_month", "type": "select", "required": false },
    { "name": "department", "type": "select", "required": true },
    { "name": "job_role", "type": "select", "required": true },
    { "name": "years_experience", "type": "number", "required": true },
    { "name": "self_evaluation", "type": "range", "required": true }
  ],
  "routing_logic": {
    "rules": [
      {
        "if": "self_evaluation < 35",
        "then": "basic"
      },
      {
        "if": "job_role in ['operator', 'setup_tech'] or (years_experience < 2 and self_evaluation < 40)",
        "then": "basic"
      },
      {
        "if": "job_role in ['process_tech', 'supervisor'] or (years_experience >= 2 and years_experience < 6 and self_evaluation >= 40 and self_evaluation <= 70)",
        "then": "medium"
      },
      {
        "if": "job_role in ['process_eng', 'mold_eng', 'quality_eng', 'plant_manager'] or (years_experience >= 6 and self_evaluation > 70)",
        "then": "advanced"
      }
    ],
    "default": "basic"
  }
}
